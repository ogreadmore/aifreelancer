    "section_reviews": {
      "description": "Explicit timezone-aware chapter and resources-subsection editorial checkpoints. Null means an unknown content-update time; the builder rejects updates later than review. Source-observation dates remain separate. The initial timestamp is the release checkpoint, not a reconstructed historical edit time.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "content_updated_at": {
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
            "type": [
              "string",
              "null"
            ]
          },
          "editor_note": {
            "type": "string"
          },
          "editorial_reviewed_at": {
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
            "type": "string"
          },
          "history_anchor": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "editorial_reviewed_at",
          "content_updated_at",
          "editor_note",
          "history_anchor"
        ],
        "type": "object"
